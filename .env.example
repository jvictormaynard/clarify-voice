# Optional development overrides. End users can configure providers in the UI.
# Copy this file to .env and fill only the values you need. Never commit .env.

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or an OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIO_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini

# Groq or a Groq-compatible endpoint
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Optional cross-provider text refinement selection
REFINEMENT_PROVIDER=
REFINEMENT_MODEL=
